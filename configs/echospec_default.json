{
  "description": "Canonical EchoSpec two-stage training hyperparameters (shared across Qwen2.5-3B, Qwen2.5-7B, and Llama-3.1-8B without per-model tuning).",
  "supported_backbones": [
    "Qwen/Qwen2.5-7B-Instruct",
    "meta-llama/Llama-3.1-8B-Instruct",
    "Qwen/Qwen2.5-3B-Instruct"
  ],
  "stage1_synthesis": {
    "teacher_model": "Qwen/Qwen2.5-32B-Instruct",
    "per_item": 3,
    "samples": 4,
    "temperature": 0.8,
    "max_searches": 4,
    "min_delete_searches": 3,
    "prefer_deep": 1,
    "exclude_seen": 1,
    "family_probs": "inject:0.6,delete:0.15,consistent:0.1,dup:0.15",
    "m_probs": "1:0.1,3:0.2,5:0.3,8:0.4"
  },
  "stage1_sft_warmstart": {
    "sft_steps": 60,
    "sft_batch": 64,
    "sft_lr": 0.0001,
    "lora_rank": 64,
    "lora_alpha": 128
  },
  "stage2_lambda_grpo": {
    "families": "identity,dup,inject,consistent,rewrite,delete",
    "family_probs": "dup:0.1,inject:0.4,consistent:0.15,rewrite:0.1,delete:0.25",
    "m_probs": "1:0.1,2:0.1,3:0.2,5:0.25,8:0.35",
    "lam": 0.1,
    "ground_alpha": 0.25,
    "acq_beta": 0.3,
    "adv_norm": "none",
    "kl_beta": 0.001,
    "lr": 1e-05,
    "items_per_step": 12,
    "group_size": 6,
    "steps": 200,
    "max_searches": 4,
    "temperature": 1.0,
    "exclude_seen": 1,
    "async_rollout": 1
  }
}
